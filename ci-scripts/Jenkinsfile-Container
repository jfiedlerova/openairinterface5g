        stage ("SA-Handover-CN5G") {
          when { expression {do5Gtest} }
          steps {
            script {
              triggerDownstreamJob ('RAN-SA-Handover-CN5G', 'SA-Handover-CN5G')
            }
          }
          post {
            always {
              script {
                // Using a unique variable name for each test stage to avoid overwriting on a global variable
                // due to parallel-time concurrency
                saHandoverStatus = finalizeDownstreamJob('RAN-SA-Handover-CN5G')
              }
            }
            failure {
              script {
                currentBuild.result = 'FAILURE'
                failingStages += saHandoverStatus
              }
            }
          }
        }
        stage ("SA-AERIAL-OAIUE-CN5G") {
          when { expression {do5Gtest || do5GUeTest} }
          steps {
            script {
              triggerDownstreamJob ('RAN-SA-AERIAL-OAIUE-CN5G', 'SA-AERIAL-OAIUE-CN5G')
            }
          }
          post {
            always {
              script {
                // Using a unique variable name for each test stage to avoid overwriting on a global variable
                // due to parallel-time concurrency
                saAERIALOAIUEStatus = finalizeDownstreamJob('RAN-SA-AERIAL-OAIUE-CN5G')
              }
            }
            failure {
              script {
                currentBuild.result = 'FAILURE'
                failingStages += saAERIALOAIUEStatus
              }
            }
          }
        }
        stage ("SA-OAIUE-CN5G") {
          when { expression {do5Gtest || do5GUeTest} }
          steps {
            script {
              triggerDownstreamJob ('RAN-SA-OAIUE-CN5G', 'SA-OAIUE-CN5G')
            }
          }
          post {
            always {
              script {
                // Using a unique variable name for each test stage to avoid overwriting on a global variable
                // due to parallel-time concurrency
                saOAIUEStatus = finalizeDownstreamJob('RAN-SA-OAIUE-CN5G')
              }
            }
            failure {
              script {
                currentBuild.result = 'FAILURE'
                failingStages += saOAIUEStatus
              }
            }
          }
        }
      }
    }
  }
  post {
    always {
      script {
        if (gh.IS_PR) {
          def body = "OAI ${JOB_NAME} [build ${BUILD_ID}](${BUILD_URL}): ${currentBuild.currentResult}"
          if (failingStages) {
            body += "\n\nFailed stages:\n${failingStages}"
          }
          writeFile file: 'pr_comment.md', text: body
          withCredentials([string(credentialsId: 'github-notify-pat',
                                  usernameVariable: 'GH_USER',
                                  passwordVariable: 'GH_TOKEN')]) {
            sh "gh pr comment ${gh.PR_NUMBER} --repo jfiedlerova/openairinterface5g --body-file pr_comment.md"
          }
          sh "rm -f pr_comment.md"
        }
      }
    }
    success {
      script {
        def message = "OAI " + JOB_NAME + " build (" + BUILD_ID + "): passed (" + BUILD_URL + ")"
        if (gh.IS_PR) {
          githubNotify account: 'jfiedlerova',
                       repo: 'openairinterface5g',
                       credentialsId: 'github-notify-pat',
                       sha: gh.COMMIT_SHA,
                       status: 'SUCCESS',
                       description: message,
                       context: 'Jenkins OAI CI'
        }
        echo "Pipeline is SUCCESSFUL"
      }
    }
    failure {
      script {
        def message = "OAI " + JOB_NAME + " build (" + BUILD_ID + "): failed (" + BUILD_URL + ")"
        if (gh.IS_PR) {
          def fullMessage = message + '\n\nList of failing test stages:' + failingStages
          githubNotify account: 'jfiedlerova',
                       repo: 'openairinterface5g',
                       credentialsId: 'github-notify-pat',
                       sha: gh.COMMIT_SHA,
                       status: 'FAILURE',
                       description: fullMessage,
                       context: 'Jenkins OAI CI'
        }
        echo "Pipeline FAILED"
      }
    }
  }
}

// ----  Slave Job functions

def triggerDownstreamJob (jobName, statusName) {
  def PR_NUMBER = gh.IS_PR ? gh.PR_NUMBER : 'develop'
  // Workaround for the "cancelled" GitLab pipeline notification
  // The downstream job is triggered with the propagate false so the following commands are executed
  // Its status is now PASS/SUCCESS from a stage pipeline point of view
  // localStatus variable MUST be analyzed to properly assess the status
  def localStatus = build job: jobName,
    parameters: [
      string(name: 'targetRepo', value: String.valueOf(gh.TARGET_REPO)),
      string(name: 'sourceRepo', value: String.valueOf(gh.SRC_REPO)),
      string(name: 'sourceBranch', value: String.valueOf(gh.SRC_BRANCH)),
      string(name: 'sourceCommit', value: String.valueOf(gh.COMMIT_SHA)),
      string(name: 'requestNumber', value: String.valueOf(gh.PR_NUMBER)),
      booleanParam(name: 'mergeWithTarget', value: env.GITHUB_PR_NUMBER != null),
      string(name: 'targetBranch', value: String.valueOf(gh.TARGET_BRANCH)),
      string(name: 'testBranch', value: "${gh.SRC_BRANCH}-${gh.COMMIT_SHA}"),
      string(name: 'repository', value: String.valueOf(params.ciRepositoryURL)),
      string(name: 'branch', value: "${gh.SRC_BRANCH.replace('/', '-')}-${gh.COMMIT_SHA}")
    ], propagate: false
  def localResult = localStatus.getResult()
  echo "${jobName} Downstream Job status is ${localResult}"
  def passed = localStatus.resultIsBetterOrEqualTo('SUCCESS')
  publishChecks name: statusName,
                status: 'COMPLETED',
                conclusion: passed ? 'SUCCESS' : 'FAILURE',
                detailsURL: localStatus.absoluteUrl
  if (!passed) {
    error "${jobName} Downstream Job is KO"
  }
}

def triggerCN5GDownstreamJob (jobName, statusName) {
  if (gh.IS_PR) {
    fullRanTag = OAI_Registry + '/oai-gnb:' + "${gh.SRC_BRANCH.replace('/', '-')}-${gh.COMMIT_SHA}"
  } else {
    fullRanTag = OAI_Registry + '/oai-gnb:develop-' + env.GIT_COMMIT
  }
  // Workaround for the "cancelled" GitLab pipeline notification
  // The downstream job is triggered with the propagate false so the following commands are executed
  // Its status is now PASS/SUCCESS from a stage pipeline point of view
  // localStatus variable MUST be analyzed to properly assess the status
  def localStatus = build job: jobName,
    parameters: [
      string(name: 'FULL_RAN_TAG', value: String.valueOf(fullRanTag))
    ], propagate: false
  def localResult = localStatus.getResult()
  echo "${jobName} Downstream Job status is ${localResult}"
  def passed = localStatus.resultIsBetterOrEqualTo('SUCCESS')
  publishChecks name: statusName,
                status: 'COMPLETED',
                conclusion: passed ? 'SUCCESS' : 'FAILURE',
                detailsURL: localStatus.absoluteUrl
  if (!passed) {
    error "${jobName} Downstream Job is KO"
  }
}

def finalizeDownstreamJob(jobName) {
  lock ('Parent-Lock') {
    // In case of any non-success, we are retrieving the HTML report of the last completed
    // downstream job. The only drop-back is that we may retrieve the HTML report of a previous build
    if (jobName == 'OAI-CN5G-COTS-UE-Test') {
      fileName = "test_results_oai_cn5g_cots_ue.html"
    } else {
      fileName = "test_results-${jobName}.html"
    }
    artifactUrl = BUILD_URL
    if (!fileExists(fileName)) {
      copyArtifacts(projectName: jobName,
        filter: 'test_results*.html',
        selector: lastCompleted(),
        optional: true)
      if (fileExists(fileName)) {
        sh "sed -i -e 's#TEMPLATE_BUILD_TIME#${env.JOB_TIMESTAMP}#' ${fileName}"
      } else {
        sh "echo \"could not copy results from ${jobName}, please check pipeline ${BUILD_URL}\" > ${fileName}"
      }
      archiveArtifacts artifacts: fileName
      // BUILD_URL is like  http://server:port/jenkins/job/foo/15/
      // no need to add a prefixed '/'
      artifactUrl += 'artifact/' + fileName
    }
    artifactUrl = "\n * [${jobName}](${artifactUrl})"
    return artifactUrl
  }
}
