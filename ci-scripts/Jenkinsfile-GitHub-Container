// Tags to shorten pipeline duration
def doBuild = true
def do4Gtest = false
def do5Gtest = false
def do5GUeTest = false

def initGithubContext() {
  return [
    IS_PR         : (env.pr_number != null),
    ACTION        : env.action ?: 'Push',
    PR_NUMBER     : env.pr_number ?: 'test_github',
    LABELS        : env.pr_label ?: [],
    SRC_BRANCH    : env.pr_source_branch ?: env.GIT_BRANCH,
    SRC_REPO      : env.pr_source_repo,
    TARGET_BRANCH : env.pr_target_branch ?: '',
    TARGET_REPO   : env.pr_target_repo ?: '',
    COMMIT_SHA    : env.pr_commit_sha ?: env.GIT_COMMIT,
    AUTHOR_EMAIL  : sh(returnStdout: true, script: "git log -1 --pretty=format:%ae ${env.GIT_COMMIT}").trim()
  ]
}

