// github context
def gh

def initGithubContext() {
  return [
    IS_PR         : (env.pr_number != null),
    PR_NUMBER     : env.pr_number ?: '',
    SRC_BRANCH    : env.pr_source_branch ?: env.GIT_BRANCH,
    SRC_REPO      : env.pr_source_repo,
    TARGET_BRANCH : env.pr_target_branch ?: '',
    TARGET_REPO   : env.pr_target_repo ?: '',
    COMMIT_SHA    : env.pr_commit_id,
    AUTHOR_EMAIL  : sh(
        returnStdout: true,
        script: "git log -1 --pretty=format:%ae ${env.pr_commit_id}"
    ).trim()
  ]
}

pipeline {
  agent { label params.nodeExecutor }
  options {
    timestamps()
    ansiColor('xterm')
  }

  stages {
    stage ("Init") {
      steps {
        script {
          gh = initGithubContext()
          echo "Action              :   ${env.action}"
          echo "Refs                :   ${env.ref}"
          echo "CI executor node    :   ${params.nodeExecutor}"
          echo "PR number           :   ${gh.PR_NUMBER}"
          echo "Commit ID           :   ${gh.COMMIT_SHA}"
          echo "Source Branch       :   ${gh.SRC_BRANCH}"
          echo "Source Repository   :   ${gh.SRC_REPO}"
          echo "Target Branch       :   ${gh.TARGET_BRANCH}"
          echo "Target Repo         :   ${gh.TARGET_REPO}"
          echo "Label               :   ${env.pr_label}
        }
      }
    }
    stage ("Check conflicts") {
      steps {
        script {
          if (gh.IS_PR) {
            try {
              checkout([
                $class: 'GitSCM',
                branches: [[name: "refs/pull/${env.pr_id}/merge"]],
                userRemoteConfigs: [[url: env.GIT_URL]]
              ])
            } catch (err) {
              error("Merge conflict detected: cannot merge PR #${gh.PR_ID} into ${gh.TARGET_BRANCH}")
            }
          } else {
            checkout scm
          }
        }
      }
    }
  }
}
