//
def IS_PR
def PR_ID
def SRC_BRANCH
def TARGET_BRANCH
def COMMIT_SHA
def AUTHOR_EMAIL

// list of failing stages
def failingStages = ""

OAI_Registry = "gracehopper3-oai.sboai.cs.eurecom.fr"

def initGithubContext() {
    IS_PR         = (env.CHANGE_ID != null)
    PR_ID         = env.CHANGE_ID ?: ''
    SRC_BRANCH    = env.CHANGE_BRANCH ?: env.GIT_BRANCH
    TARGET_BRANCH = env.CHANGE_TARGET ?: ''
    COMMIT_SHA    = env.GIT_COMMIT
    AUTHOR_EMAIL  = sh(
        returnStdout: true,
        script: "git log -1 --pretty=format:%ae ${COMMIT_SHA}"
    ).trim()
}

pipeline {
  agent { label params.nodeExecutor }
  options {
    timestamps()
    ansiColor('xterm')
  }

  stages {
    stage ("Init") {
      steps {
        script {
          initGithubContext()
          echo "CI executor node    :   ${params.nodeExecutor}"
          echo "PR number           :   ${PR_ID}"
          echo "Source Branch       :   ${SRC_BRANCH}"
          echo "Target Branch       :   ${TARGET_BRANCH}"
          echo "Commit ID           :   ${COMMIT_SHA}"
        }
      }
    }
    stage ("Check conflicts") {
      steps {
        script {
          if (IS_PR) {
            try {
              checkout([
                $class: 'GitSCM',
                branches: [[name: "refs/pull/${PR_ID}/merge"]],
                userRemoteConfigs: [[url: env.GIT_URL]]
              ])
            } catch (err) {
              error("Merge conflict detected: cannot merge PR #${PR_ID} into ${TARGET_BRANCH}")
            }
          } else {
            checkout scm
          }
        }
      }
    }
  }
}
